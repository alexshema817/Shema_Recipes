# Copy to .env for local dev (netlify dev loads .env automatically).
# Set the same variables in the Netlify dashboard for production.
# NEVER put real values in this file - it is meant to be committed.

# --- Kroger Developer API (https://developer.kroger.com) ---
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
# Base URL of the Kroger public API. "/v1" is appended automatically if missing.
KROGER_API_BASE=https://api.kroger.com/v1
# OAuth2 token endpoint. The authorize endpoint is derived from it (token -> authorize).
KROGER_TOKEN_URL=https://api.kroger.com/v1/connect/oauth2/token
# Must exactly match a redirect URI registered on your Kroger app.
#   local: http://localhost:8888/api/kroger/callback
#   prod:  https://<your-site>.netlify.app/api/kroger/callback
KROGER_REDIRECT_URI=http://localhost:8888/api/kroger/callback

# --- Anthropic ---
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-sonnet-5-5
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- App login ---
APP_USERNAME=
APP_PASSWORD=
# Random string, at least 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
